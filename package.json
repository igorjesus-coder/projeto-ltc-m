{
  "name": "projeto-ltc-m",
  "version": "0.1.0",
  "private": true,
  "description": "CRUD, banco Supabase/PostgreSQL e camada analítica do portfólio LTC-M.",
  "workspaces": [
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run env:check && npm run migrations:check && npm run seeds:check && npm run integrity:check && npm run p007:check && npm run p008:check && npm run d28:check && npm run p009:check && npm run pw902:check && npm run d21:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "dev": "npm run dev --workspace @ltcm/web",
    "d21:check": "node scripts/check-d21-inactivation-fix.mjs",
    "d28:check": "node scripts/check-p008-d28.mjs",
    "env:check": "node scripts/check-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "integrity:check": "node scripts/check-integrity-tests.mjs",
    "ltcm:extract": "npm run build --workspace @ltcm/extractor --silent && node tools/ltcm-extractor/dist/src/cli.js",
    "ltcm:normalize-projects": "npm run build --workspace @ltcm/normalizer --silent && node tools/ltcm-normalizer/dist/src/cli.js",
    "lint": "npm run lint --workspaces --if-present",
    "migrations:check": "node scripts/check-migrations.mjs",
    "p007:check": "node scripts/check-p007-tests.mjs",
    "p008:check": "node scripts/check-p008-tests.mjs && node scripts/check-p008-d28.mjs && node scripts/run-p008-dynamic-validation.mjs --check",
    "p009:check": "node scripts/check-p009-tests.mjs && node scripts/p009-rendered-sql-gate.mjs",
    "p009:render:gate": "node scripts/p009-rendered-sql-gate.mjs --write",
    "p008:runtime:dry-run": "node scripts/run-p008-dynamic-validation.mjs --dry-run",
    "p008:runtime:validate": "node scripts/run-p008-dynamic-validation.mjs",
    "p009:runtime:validate": "node scripts/run-p009-validation-launcher.mjs",
    "pw902:check": "node scripts/check-pw902-fix.mjs",
    "seeds:check": "node scripts/check-seeds.mjs",
    "test": "npm run test:env && npm run test:migrations && npm run test:seeds && npm run test:integrity && npm run test:p007 && npm run test:p008 && npm run test:d28 && npm run test:p009 && npm run test:p010 && npm run test:p011 && npm run test:pw902 && npm run test:d21 && npm run test --workspace @ltcm/web --if-present",
    "test:d21": "node --test scripts/check-d21-inactivation-fix.test.mjs",
    "test:env": "node --test scripts/check-env.test.mjs",
    "test:integrity": "node --test scripts/check-integrity-tests.test.mjs",
    "test:migrations": "node --test scripts/check-migrations.test.mjs scripts/collect-db-inventory.test.mjs",
    "test:p007": "node --test scripts/check-p007-tests.test.mjs",
    "test:p008": "node --test scripts/check-p008-tests.test.mjs scripts/run-p008-dynamic-validation.test.mjs",
    "test:p009": "node --test scripts/check-p009-tests.test.mjs scripts/p009-rendered-sql-gate.test.mjs scripts/p009-evidence-protocol.test.mjs",
    "test:p009:evidence": "node --test scripts/p009-evidence-protocol.test.mjs",
    "test:p009:gate": "node --test scripts/p009-rendered-sql-gate.test.mjs",
    "test:p009:request": "node --test scripts/run-p008-dynamic-validation.test.mjs scripts/check-p009-tests.test.mjs",
    "test:p010": "npm run test --workspace @ltcm/extractor",
    "test:p011": "npm run test --workspace @ltcm/normalizer",
    "test:d28": "node --test scripts/check-p008-d28.test.mjs",
    "test:pw902": "node --test scripts/check-pw902-fix.test.mjs",
    "test:seeds": "node --test scripts/check-seeds.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "supabase": "2.110.0"
  }
}
