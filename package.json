{
  "name": "projeto-ltc-m",
  "version": "0.1.0",
  "private": true,
  "description": "CRUD, banco Supabase/PostgreSQL e camada analítica do portfólio LTC-M.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run env:check && npm run migrations:check && npm run seeds:check && npm run integrity:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "dev": "npm run dev --workspace @ltcm/web",
    "env:check": "node scripts/check-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "integrity:check": "node scripts/check-integrity-tests.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "migrations:check": "node scripts/check-migrations.mjs",
    "seeds:check": "node scripts/check-seeds.mjs",
    "test": "npm run test:env && npm run test:migrations && npm run test:seeds && npm run test:integrity && npm run test --workspaces --if-present",
    "test:env": "node --test scripts/check-env.test.mjs",
    "test:integrity": "node --test scripts/check-integrity-tests.test.mjs",
    "test:migrations": "node --test scripts/check-migrations.test.mjs scripts/collect-db-inventory.test.mjs",
    "test:seeds": "node --test scripts/check-seeds.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "supabase": "2.110.0"
  }
}
