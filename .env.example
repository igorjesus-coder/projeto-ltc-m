# Frontend variables are public and must use the VITE_ prefix.
VITE_APP_ENV=local
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Preferred for hosted projects using current Supabase API keys.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy/local compatibility. Use only when a publishable key is not available.
VITE_SUPABASE_ANON_KEY=

# Server-only credentials must never use the VITE_ prefix.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
