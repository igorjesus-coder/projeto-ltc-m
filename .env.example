# Frontend variables are public and must use the VITE_ prefix.
VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Backend-only variables. They must never be exposed by Vite or committed with real values.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
DATABASE_URL=
