# Frontend variables are public and must use the VITE_ prefix.
# Copy only this block to apps/web/.env.<environment>.local when the integration exists.
# P020 uses only these public Auth0 values in the browser; never place secrets in VITE_*.
VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_REDIRECT_URI=

# Backend-only variables for apps/api and Render.
# They must never be exposed by Vite or committed with real values.
NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=
DATABASE_URL=
DATABASE_SSL_MODE=disable
