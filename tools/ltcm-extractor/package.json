{
  "name": "@ltcm/extractor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./p013": {
      "types": "./dist/src/p013-monthly-source.d.ts",
      "default": "./dist/src/p013-monthly-source.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "extract": "npm run build --silent && node dist/src/cli.js",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  }
}
